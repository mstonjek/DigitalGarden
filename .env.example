# Local development overrides for docker-compose.yml (gitignored).
# Copy to .env and fill in real values from your GitHub OAuth app.
# Production (Coolify) sets these as service environment variables instead.
DEBUG_MODE=1
TZ=Europe/Prague
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/callback
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=root
DB_NAME=digitalgarden
