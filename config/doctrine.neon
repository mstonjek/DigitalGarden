extensions:
    nettrine.dbal: Nettrine\DBAL\DI\DbalExtension(%debugMode%)
    nettrine.orm: Nettrine\ORM\DI\OrmExtension
    nettrine.migrations: Nettrine\Migrations\DI\MigrationsExtension

nettrine.dbal:
    types:
        uuid_binary: Ramsey\Uuid\Doctrine\UuidBinaryType
    connections:
        default:
            driver: pdo_mysql
            host: %doctrine.host%
            user: %doctrine.user%
            password: %doctrine.password%
            dbname: %doctrine.dbname%
            charset: utf8mb4

nettrine.orm:
    managers:
        default:
            connection: default
            # PHP 8.4+ native lazy objects. Without this, Doctrine ORM falls
            # back to Symfony LazyGhost, which no longer exists in
            # symfony/var-exporter 8 (hard failure at EntityManager boot).
            # Native lazy objects are also mandatory in ORM 4.
            lazyNativeObjects: true
            mapping:
                "App.Model.Entity":
                    directories: [%appDir%/Model/Entity]
                    namespace: App\Model\Entity
            defaultCache: Symfony\Component\Cache\Adapter\FilesystemAdapter(namespace: orm, defaultLifetime: 0, directory: %tempDir%/cache/doctrine/orm)

nettrine.migrations:
    directories:
        App\migrations: %appDir%/migrations
    versionsOrganization: null
    table: doctrine_migrations
    column: version
